<mxfile host="drawio" type="device"><diagram id="Casos de Uso - Help Desk" name="Casos de Uso - Help Desk"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Diagrama de Casos de Uso — Sistema Help Desk (Chamados de TI)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="170" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="v2" value="Sistema Help Desk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="170" y="60" width="1400" height="1150" as="geometry"/></mxCell><mxCell id="v3" value="Aplicativo Principal (helpdesk.exe)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="190" y="100" width="925" height="1095" as="geometry"/></mxCell><mxCell id="v4" value="Painel Administrativo (painel_admin.exe)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="1130" y="100" width="420" height="1095" as="geometry"/></mxCell><mxCell id="v5" value="Usuário Comum" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="40" height="80" as="geometry"/></mxCell><mxCell id="v6" value="Técnico de TI" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="40" height="80" as="geometry"