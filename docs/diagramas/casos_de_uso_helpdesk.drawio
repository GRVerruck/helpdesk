hamado" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3a5f8f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="740" width="210" height="56" as="geometry"/></mxCell><mxCell id="v16" value="UC09 – Atualizar status do chamado" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3a5f8f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="820" width="210" height="56" as="geometry"/></mxCell><mxCell id="v17" value="UC10 – Registrar atendimento (diagnóstico, solução ou observação)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3a5f8f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="810" width="210" height="56" as="geometry"/></mxCell><mxCell id="v18" value="UC11 – Registrar saída de equipamento para o chamado" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3a5f8f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="940" width="210" height="56" as="geometry"/></mxCell><mxCell id="v19" value="UC12 – Cadastrar equipamento" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3a5f8f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="920" width="210" height="56" as="geometry"/></mxCell><mxCell id="v20" value="UC13 – Consultar estoque" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3a5f8f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="990" width="210" height="56" as="geometry"/></mxCell><mxCell id="v21" value="UC14 – Atualizar equipamento (dados e reposição)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3a5f8f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1060" width="210" height="56" as="geometry"/></mxCell><mxCell id="v22" value="UC15 – Dar baixa em equipamento" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3a5f8f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1130" width="210" height="56" as="geometry"/></mxCell><mxCell id="v23" value