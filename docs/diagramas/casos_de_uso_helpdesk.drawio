yDx=0;entryDy=0;" edge="1" parent="1" source="v7" target="v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e49" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v7" target="v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e50" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v7" target="v28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e51" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v7" target="v29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e52" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v7" target="v30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e53" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v7" target="v31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e54" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v16" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e55" value="«extend»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v12" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e56" value="«extend»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v12" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e57" value="«extend»&lt;br&gt;[houve entrega/troca de equipamento]" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v18" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v58" value="&lt;b&gt;RN06 – Hierarquia de cadastro:&lt;/b&gt; o autocadastro gera apenas Usuário Comum; técnicos e administradores só são cadastrados por um administrador." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#b59a3a;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="868" y="130" width="235" height="72" as="geometry"/></mxCell><mxCell id="e59" value="" style="endArrow=none;dashed=1;dashPattern=2 3;html=1;rounded=0;strokeColor=#b59a3a;" edge="1" parent="1" source="v58" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v60" value="&lt;b&gt;RN01 – Cancelamento:&lt;/b&gt; só o próprio solicitante pode cancelar o chamado, e somente enquanto o status for ABERTO." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#b59a3a;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="868" y="275" width="235" height="62" as="geometry"/></mxCell><mxCell id="e61" value="" style="endArrow=none;dashed=1;dashPattern=2 3;html=1;rounded=0;strokeColor=#b59a3a;" edge="1" parent="1" source="v60" target="v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v62" value="&lt;b&gt;RN02 – Limite de atendimento:&lt;/b&gt; só chamados ABERTO podem ser assumidos e cada técnico pode ter no máximo 5 chamados EM_ATENDIMENTO." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#b59a3a;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="868" y="670" width="235" height="72" as="geometry"/></mxCell><mxCell id="e63" value="" style="endArrow=none;dashed=1;dashPattern=2 3;html=1;rounded=0;strokeColor=#b59a3a;" edge="1" parent="1" source="v62" target="v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v64" value="&lt;b&gt;RN03 – Mudança de status:&lt;/b&gt; toda alteração de status gera um registro de atendimento; o chamado só vai para RESOLVIDO se houver registro do tipo SOLUÇÃO." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#b59a3a;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="868" y="775" width="235" height="84" as="geometry"/></mxCell><mxCell id="e65" value="" style="endArrow=none;dashed=1;dashPattern=2 3;html=1;rounded=0;strokeColor=#b59a3a;" edge="1" parent="1" source="v64" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v66" value="&lt;b&gt;RN04 – Estoque:&lt;/b&gt; a quantidade de um equipamento nunca fica negativa; equipamento baixado não pode ser movimentado." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#b59a3a;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="868" y="1010" width="235" height="62" as="geometry"/></mxCell><mxCell id="e67" value="" style="endArrow=none;dashed=1;dashPattern=2 3;html=1;rounded=0;strokeColor=#b59a3a;" edge="1" parent="1" source="v66" target="v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e68" value="" style="endArrow=none;dashed=1;dashPattern=2 3;html=1;rounded=0;strokeColor=#b59a3a;" edge="1" parent="1" source="v66" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v69" value="&lt;b&gt;RN05 – Exclusão de técnico:&lt;/b&gt; técnico com chamados EM_ATENDIMENTO não pode ser excluído." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#b59a3a;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1140" y="465" width="168" height="72" as="geometry"/></mxCell><mxCell id="e70" value="" style="endArrow=none;dashed=1;dashPattern=2 3;html=1;rounded=0;strokeColor=#b59a3a;" edge="1" parent="1" source="v69" target="v27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v71" value="&lt;b&gt;RN06 – Hierarquia:&lt;/b&gt; só administradores cadastram ou desativam administradores, e deve existir sempre pelo menos um administrador ativo." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#b59a3a;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1140" y="635" width="168" height="96" as="geometry"/></mxCell><mxCell id="e72" value="" style="endArrow=none;dashed=1;dashPattern=2 3;html=1;rounded=0;strokeColor=#b59a3a;" edge="1" parent="1" source="v71" target="v29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v73" value="&lt;b&gt;Operações CRUD&lt;/b&gt;&lt;br&gt;Chamado: C = UC02 · R = UC03, UC05, UC07, UC23 · U = UC08, UC09 · D (cancelamento lógico) = UC04&lt;br&gt;Equipamento: C = UC12 · R = UC13 · U = UC14, UC11 · D (baixa) = UC15&lt;br&gt;Técnico: C = UC17 · R = UC18 · U = UC19 · D = UC20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1140" y="960" width="400" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>